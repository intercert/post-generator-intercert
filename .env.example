# Copie este arquivo para .env.local e preencha com as suas chaves.
# Basta configurar pelo menos um provedor de texto/LLM.

# Provedores de Texto/LLM
OPENAI_API_KEY="sk-proj-..."
GEMINI_API_KEY="AIzaSy..."
ANTHROPIC_API_KEY="sk-ant-..."

# URL Base
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Banco de dados (MySQL ou MariaDB). Crie o banco vazio antes:
#   CREATE DATABASE post_generator CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Depois rode: npm run db:migrate
# A senha pode ter qualquer símbolo e pode ficar vazia (como o root do XAMPP).
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=post_generator

# Login do painel (obrigatório: sem eles ninguém consegue entrar)
LOGIN_EMAIL="voce@suaempresa.com.br"
LOGIN_PASSWORD="troque-esta-senha"
# Opcional: chave que assina o cookie de sessão. Sem ela, é derivada do e-mail/senha.
# AUTH_SECRET="uma-string-longa-e-aleatoria"
