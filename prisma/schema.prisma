// Banco do gerador de posts (MySQL). Sem login por enquanto: existe uma única empresa ("default"),
// mas todas as tabelas já guardam o workspaceId para receber várias empresas depois.
//
// Textos longos e JSON ficam em colunas de texto (LongText/Text) em vez de Json, para funcionar igual
// em MySQL e MariaDB. Colunas de texto não aceitam valor padrão no MySQL, então o app sempre as preenche.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum EntryStatus {
  pendente
  gerado
  postado
}

model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand   Brand?
  entries CalendarEntry[]
  posts   Post[]
}

/// Identidade visual aprendida (perfil + logos). O perfil é um JSON em texto, sem as logos.
model Brand {
  workspaceId String   @id
  profile     String   @db.LongText
  logo        String   @db.LongText
  logoClara   String   @db.LongText
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Um dia planejado no calendário (um por data).
model CalendarEntry {
  id          String      @id @default(cuid())
  workspaceId String
  /// YYYY-MM-DD
  date        String      @db.Char(10)
  /// JSON: lista de datas comemorativas
  ocasioes    String      @db.Text
  objetivo    String      @db.VarChar(255)
  detalhes    String      @db.Text
  status      EntryStatus @default(pendente)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@index([workspaceId, status])
}

/// O post gerado de um dia: arte final (PNG) e tudo o que serve para reaproveitar em outra IA.
model Post {
  id            String   @id @default(cuid())
  workspaceId   String
  /// YYYY-MM-DD, o mesmo dia do calendário
  date          String   @db.Char(10)
  titulo        String   @db.VarChar(255)
  layout        String   @db.VarChar(20)
  formatId      String   @db.VarChar(80)
  legenda       String   @db.Text
  usedProvider  String   @db.VarChar(120)
  imageProvider String   @db.VarChar(160)
  imageWarning  String   @db.Text
  imagePrompt   String   @db.Text
  imageJson     String   @db.LongText
  postPrompt    String   @db.LongText
  postJson      String   @db.LongText
  brandJson     String   @db.LongText
  imageType     String   @db.VarChar(40)
  image         Bytes    @db.LongBlob
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
}
